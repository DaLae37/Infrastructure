# Next.js upstream
upstream next-www {
    zone next-www 64k;

    resolver 127.0.0.11 valid=30s ipv6=off;
    resolver_timeout 5s;

    server ${NEXT_HOST}:${NEXT_PORT} resolve;

    keepalive 32;
}

# Default HTTP server
server {
    listen ${HTTP_PORT} default_server;

    server_name _;

    # Docker health check
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Reject unknown Host headers
    location / {
        return 444;
    }
}

# www.dalae37.com - HTTP
server {
    listen ${HTTP_PORT};

    server_name www.dalae37.com;

    # Health check must remain available over HTTP
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Redirect normal HTTP traffic to HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}

# Default HTTPS server
server {
    listen ${HTTPS_PORT} ssl default_server;
    server_name _;
    ssl_reject_handshake on;
}

# www.dalae37.com - HTTPS
server {
    listen ${HTTPS_PORT} ssl;
    http2 on;

    server_name www.dalae37.com;

    ssl_certificate
        /etc/letsencrypt/live/www.dalae37.com/fullchain.pem;

    ssl_certificate_key
        /etc/letsencrypt/live/www.dalae37.com/privkey.pem;

    include /etc/nginx/snippets/ssl.conf;

    client_max_body_size 10m;

    # Nginx health check
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Naver site ownership verification
    location ~ ^/naver.*\.html$ {
        root /usr/share/nginx/html/verification;
    }

    # Next.js
    location / {
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://next-www;
    }

    location ~ /\.(?!well-known/) {
        deny all;
    }
}
